// Aurora V26.13 Volumetric Cloud Fragment Shader (16bps speed, rain swelling, Mirai strings)
#version 300 es

precision highp float;

in vec2 TexCoord;
in vec3 CloudPos;

uniform vec4 TIME;
uniform float RAIN_WEIGHT;
uniform vec4 FOG_COLOR;

out vec4 fragColor;

float noise(vec2 p) {
    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
}

float fbm(vec2 p) {
    float f = 0.0;
    float w = 0.5;
    for (int i = 0; i < 4; i++) {
        f += w * noise(p);
        p *= 2.0;
        w *= 0.5;
    }
    return f;
}

void main() {
    // 16 blocks per second cloud movement: TIME.x * 16.0
    vec2 speed = vec2(TIME.x * 16.0 * 0.05, 0.0);
    vec2 p = TexCoord * 4.0 + speed;
    
    float n = fbm(p);
    
    // Rain handling: when raining, clouds combine into one big overcast deck
    float cloudDensity = smoothstep(0.4 - RAIN_WEIGHT * 0.3, 0.8 - RAIN_WEIGHT * 0.5, n);
    
    // Fine strings of clouds like Mirai
    float strings = smoothstep(0.2, 0.4, abs(noise(p * 3.0) - 0.5));
    cloudDensity = mix(cloudDensity, 1.0, RAIN_WEIGHT * 0.8) + strings * 0.15;
    
    vec3 cloudColor = mix(vec3(0.95, 0.96, 1.0), vec3(0.5, 0.53, 0.58), RAIN_WEIGHT);
    
    fragColor = vec4(cloudColor, clamp(cloudDensity, 0.0, 1.0));
}
